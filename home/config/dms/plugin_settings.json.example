{
  "quickCapture": {
    "enabled": true,
    "doneAction": "clipboard",
    "postNotification": "toast",
    "recordMic": true,
    "recordSystemAudio": false,
    "skipConfirm": true
  },
  "homeAssistantDash": {
    "enabled": true,
    "hassUrl": "https://homeassistant.homelab.lan",
    "colorMode": "harmonized",
    "hassToken": "REPLACE_LOCALLY",
    "favorites": [
      "switch.yndx_00540"
    ]
  },
  "calculator": {
    "enabled": true,
    "trigger": "="
  },
  "aiQuotas": {
    "enabled": true
  },
  "librepods": {
    "enabled": true,
    "barDisplay": "battery"
  },
  "airpods": {
    "pollInterval": "30"
  }
}
