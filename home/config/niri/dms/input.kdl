input {
    mouse {
        accel-speed 0.0
        accel-profile "adaptive"
    }
    touchpad {
        accel-speed 0.0
        natural-scroll
        dwt
    }
    keyboard {
        xkb {
            layout "us,ru"
            options "grp:alt_shift_toggle"
        }
    }
}
