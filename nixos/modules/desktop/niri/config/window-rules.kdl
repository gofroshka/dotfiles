

window-rule {
  match app-id=r#"(?i)^google-chrome$"#
  default-column-width { proportion 1.0; }
}

// The patched chooser title distinguishes dialogs from normal dfiles windows.
window-rule {
  match app-id=r#"^dev\.duxlabs\.files$"# title=" — Dux File Chooser$"
  open-floating true
  default-column-width { fixed 1000; }
  default-window-height { fixed 700; }
}
